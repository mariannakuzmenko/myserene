# Serene — environment variables
#
# The app is fully client/SSR rendered with procedurally generated audio and
# public imagery, so NO secrets are required to run or deploy it.
# Copy this file to `.env` and fill in only what you actually use.

# --- Deployment -------------------------------------------------------------
# Nitro deploy target. Netlify sets this in netlify.toml.
# NITRO_PRESET=netlify

# --- Optional: remote audio library ---------------------------------------
# Public HTTPS base URL for real field recordings (S3 / R2 / Supabase Storage).
# Must be CORS-enabled and return audio/mpeg or audio/ogg with HTTP 200.
# Exposed to the browser — never put a private key in a VITE_ variable.
# VITE_AUDIO_CDN_URL=https://cdn.example.com/serene/audio

# --- Optional: server-only secrets ---------------------------------------
# Read these ONLY inside a server function handler (never with a VITE_ prefix).
# ANALYTICS_API_KEY=

# Absolute site origin, used for social preview image URLs (no trailing slash)
# VITE_SITE_URL=https://myserene.netlify.app
